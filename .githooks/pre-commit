#!/bin/sh
# Installed by `git config core.hooksPath .githooks`. Lifecycle subjects and gate
# wiring use parallel full tooling; other code uses fast tooling. Prose-only trees
# retain static source and consistency checks. Both code routes record the same
# hook-pre-commit target. Full tooling also runs in its own CI job and full gates.
# Read staged paths strictly and NUL-delimited, including both rename endpoints.
# A failed/empty classification takes the full route; full subjects win over docs.
route=hook-pre-commit-full
if docs=$(just --evaluate docs_paths 2>/dev/null) && full=$(just --evaluate tooling_full_paths 2>/dev/null); then
    if selected=$(python3 -c '
import fnmatch, subprocess, sys
docs, full = (value.split() for value in sys.argv[1:])
if not docs or not full:
    raise ValueError("empty routing pattern list")
out = subprocess.run(["git", "diff", "--cached", "--name-only", "--no-renames", "-z"],
                     check=True, stdout=subprocess.PIPE).stdout
paths = [name.decode("utf-8") for name in out.split(b"\0") if name]
if not paths:
    route = "hook-pre-commit-full"
elif any(fnmatch.fnmatchcase(path, pattern) for path in paths for pattern in full):
    route = "hook-pre-commit-full"
elif all(any(fnmatch.fnmatchcase(path, pattern) for pattern in docs) for path in paths):
    route = "hook-pre-commit-docs"
else:
    route = "hook-pre-commit"
print(route)
' "$docs" "$full"); then
        route=$selected
    fi
fi
exec just "$route"
