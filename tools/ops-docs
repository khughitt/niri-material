#!/usr/bin/env python3
# ops-docs version 12
"""A project's guide files — README.md for people, AGENTS.md for agents — rendered and
checked inside one repository.

Vendored from ops bin/ops-docs as tools/ops-docs. `identity.toml` at the repository root
(and at each subsystem root it names) declares what the project is; this tool renders
the declared and derived parts into marked regions of the two files and checks the rest
against the contract. It never writes prose.
Vendored from https://github.com/khughitt/ops (bin/ops-docs); never edit the copy, see tools/README.md.
Reference: ops docs/project-guides.md.

In a family home (a repository holding family.toml), `family publish` writes the
committed family file into each member as tools/family.toml and re-renders the member's
guides, and `family check` judges every member's committed copy against the home's.
A project declaring `[code]` in identity.toml cites the code organization guide in its
AGENTS.md identity region; a member of a family declaring `[code]` that has not declared
it yet cites the guide from its family region instead.
Reference: ops docs/project-guides.md.

A project declaring `[documents]` in identity.toml also has its public reference
documents' type markers, standard version, required headings and record exclusions
checked; a project that does not declare it is untouched. A marker qualifier may not
contain a digit, the tool's test for "never a version". Design:
ops docs/document-types.md.

Exit 0 clean, 1 on a stale region or a constraint finding, 2 when it cannot run.
"""
import argparse
import difflib
import json
import os
import pathlib
import posixpath
import re
import shlex
import subprocess
import sys
import tomllib

PURPOSE_MAX = 80
ABSTRACT_MAX = 400
ABSTRACT_SENTENCES = 3
AGENTS_BUDGET = 120
# The contract a project's guides are checked against. A family file (§4 of the family
# design) replaces a table; without one, this is the whole contract.
DEFAULT_CONTRACT = {
    "readme": {"lead": ["abstract"], "sections": ["Setup", "Usage", "Layout", "Consumers"],
               "status_before": "Consumers"},
    "agents": {"sections": ["Setup", "Gates", "Layout", "Rules"]},
}
FAMILY_HOME = "family.toml"
FAMILY_COPY = "tools/family.toml"
FAMILY_FIELDS = ("name", "summary", "overview", "members", "readme", "agents", "code")
MEMBER_FIELDS = ("name", "prefix", "url", "label", "title")
CODE_FIELDS = ("note",)
NOTE_MAX = 160
CONTRACT_FIELDS = {"readme": ("lead", "sections", "status_before"), "agents": ("sections",)}
LEADS = ("purpose", "abstract")
SUMMARY_MAX = 300
SUMMARY_SENTENCES = 2
LABEL_MAX = 60
_TAG = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*")
_UNSAFE_URL = re.compile(r"[\s()]")
_UNSAFE_TITLE = re.compile(r"[\[\]*_`\\]")
FIELDS = ("name", "aliases", "purpose", "abstract", "authority", "subsystems", "agents", "documents", "code")
AGENTS_FIELDS = ("budget", "scope")
SCOPES = ("project", "global")
GUIDES = ("README.md", "AGENTS.md")
DOCUMENTS_FIELDS = ("standard", "references")
# The `[code]` declaration: the code organization guide versions this tool knows.
CODE_DECLARATION_FIELDS = ("standard",)
CODE_STANDARDS = (1,)
TYPES = ("standard", "data model", "protocol", "guide")
QUALIFIER_WORDS = 4
# The rules of every document-types version this tool judges; a marker names one.
STANDARDS = {1: {"types": TYPES,
                 "headings": {"standard": ("Versions", "h2"), "protocol": ("Failure", "contains")}}}
DOCUMENT_EXCLUDED = GUIDES + ("CLAUDE.md",)
RECORD_DIRS = ("docs/specs", "docs/plans", "docs/notes", "docs/reports")
_DATED = re.compile(r"\d{4}-\d{2}-\d{2}-")
_MARKER = re.compile(r"^Type: (?P<head>[^;]+); document types (?P<version>[1-9][0-9]*)\.(?: |$)")
_MARKER_LIKE = re.compile(r"^Type: .*; document types [0-9]+\.")
IDENTITY_START = "<!-- ops:identity start — generated by ops-docs; edit identity.toml -->"
IDENTITY_END = "<!-- ops:identity end -->"
STATUS_START = "<!-- ops:status start — generated by ops-docs from the tracker; run just docs -->"
STATUS_END = "<!-- ops:status end -->"
FAMILY_START = "<!-- ops:family start — generated by ops-docs; edit family.toml in the family home -->"
FAMILY_END = "<!-- ops:family end -->"
STATUS_COMMAND = ["tasks", "list", "--json"] + [
    word for status in ("idea", "todo", "doing", "blocked", "shelved", "done", "dropped")
    for word in ("--status", status)]
OPEN = ("idea", "todo", "doing", "blocked", "shelved")

_SENTENCE = re.compile(r"[.!?]+(?=\s|$)")


class TrackerError(RuntimeError):
    """The tracker ran but did not return its task array."""


def status_records(root, run=subprocess.run):
    """Read every task status in JSON so ambient formatting cannot alter the input."""
    try:
        done = run(STATUS_COMMAND, cwd=str(root), capture_output=True, text=True)
    except FileNotFoundError as error:
        raise LookupError("the tasks binary is not on PATH and README.md has a status region") from error
    if done.returncode != 0:
        raise TrackerError(f"tasks list failed: {done.stderr.strip()}")
    try:
        records = json.loads(done.stdout)["tasks"]
    except (json.JSONDecodeError, KeyError, TypeError) as error:
        raise TrackerError(f"tasks list returned no task array: {error}") from error
    if not isinstance(records, list):
        raise TrackerError("tasks list returned no task array")
    return records


def goal_rows(records):
    """Count direct non-dropped children of each open goal."""
    by_parent = {}
    for task in records:
        if task.get("parent"):
            by_parent.setdefault(task["parent"], []).append(task)
    rows = []
    for task in records:
        if task["status"] not in OPEN or not task.get("child_count"):
            continue
        children = [c for c in by_parent.get(task["id"], []) if c["status"] != "dropped"]
        done = sum(c["status"] == "done" for c in children)
        rows.append({"id": task["id"], "title": task["title"], "done": done,
                     "total": len(children), "closed": done == len(children)})
    return sorted(rows, key=lambda row: row["id"])


def render_status(rows):
    if not rows:
        return f"{STATUS_START}\nNo open goals.\n{STATUS_END}"
    lines = [STATUS_START, "Open goals:"]
    for row in rows:
        line = f"- {row['id']} — {row['title']} — {row['done']} of {row['total']} children done"
        if row["closed"]:
            line += "; direct children closed"
        lines.append(line)
    lines.append(STATUS_END)
    return "\n".join(lines)


def repository_root(cwd):
    """The git toplevel for `cwd`; LookupError outside a repository."""
    done = subprocess.run(["git", "-C", str(cwd), "rev-parse", "--show-toplevel"],
                          capture_output=True, text=True)
    if done.returncode != 0:
        raise LookupError(f"{cwd} is not inside a git repository")
    return pathlib.Path(done.stdout.strip()).resolve()


def tracked(root, rel):
    done = subprocess.run(["git", "-C", str(root), "ls-files", "--error-unmatch", "--", rel],
                          capture_output=True, text=True)
    return done.returncode == 0


def tracked_under(root, rel):
    """The index paths under `rel`, sorted. Always asks git: a deleted directory still
    lists its indexed files, and a pathspec matching nothing lists none."""
    done = subprocess.run(["git", "-C", str(root), "ls-files", "-z", "--", rel],
                          capture_output=True, text=True)
    return sorted(p for p in done.stdout.split("\0") if p)


def top_level_documents(root):
    """Tracked `docs/<name>.md` files directly under docs/ that are undated and not a guide."""
    found = []
    for path in tracked_under(root, "docs"):
        name = posixpath.basename(path)
        if (pathlib.PurePath(path).parent == pathlib.PurePath("docs") and name.endswith(".md")
                and name not in DOCUMENT_EXCLUDED and not _DATED.match(name)):
            found.append(path)
    return found


def documents_problems(root, table, top, nested=False):
    """Every violation of the `[documents]` table, one line each, each starting `documents`."""
    if nested:
        return ["documents is not allowed in a subsystem"]
    if not isinstance(table, dict):
        return ["documents must be a table"]
    found = [f"documents: unknown key {k}" for k in sorted(set(table) - set(DOCUMENTS_FIELDS))]
    standard = table.get("standard")
    if not isinstance(standard, int) or isinstance(standard, bool) or standard not in STANDARDS:
        found.append(f"documents.standard must be one of {', '.join(map(str, STANDARDS))}")
    references = table.get("references", [])
    if not isinstance(references, list) or any(not _line(r) for r in references):
        found.append("documents.references must be a list of non-empty single lines")
        return found
    in_scope = set(top_level_documents(root))
    seen = set()
    for rel in references:
        if pathlib.PurePath(rel).is_absolute() or ".." in pathlib.PurePath(rel).parts:
            found.append(f"documents.references {rel} must be a relative path inside the repository")
            continue
        if rel != posixpath.normpath(rel):
            found.append(f"documents.references {rel} is not in canonical form; write {posixpath.normpath(rel)}")
            continue
        path = root / rel
        if not inside(top, path):
            found.append(f"documents.references {rel} resolves outside the repository ({path.resolve()})")
            continue
        base = posixpath.basename(rel)
        if base in DOCUMENT_EXCLUDED:
            found.append(f"documents.references {rel} is a guide, never a document of the standard")
        elif (any(rel == d or rel.startswith(d + "/") for d in RECORD_DIRS)
              or (rel.startswith("docs/") and _DATED.match(base))):
            found.append(f"documents.references {rel} is a decision-record location; it cannot be declared")
        elif not rel.endswith(".md"):
            found.append(f"documents.references {rel} must be a Markdown file")
        elif not path.is_file():
            found.append(f"documents.references {rel} does not exist")
        elif not tracked(root, rel):
            found.append(f"documents.references {rel} is not tracked")
        elif rel in seen:
            found.append(f"documents.references {rel} is listed twice")
        elif rel in in_scope:
            found.append(f"documents.references {rel} is already a document of the standard by its location")
        seen.add(rel)
    return found


def code_declaration_problems(table, nested=False):
    """Every violation of the identity `[code]` table, one line each, each starting `code`."""
    if nested:
        return ["code is not allowed in a subsystem"]
    if not isinstance(table, dict):
        return ["code must be a table"]
    found = [f"code: unknown key {k}" for k in sorted(set(table) - set(CODE_DECLARATION_FIELDS))]
    standard = table.get("standard")
    if not isinstance(standard, int) or isinstance(standard, bool) or standard not in CODE_STANDARDS:
        found.append(f"code.standard must be one of {', '.join(map(str, CODE_STANDARDS))}")
    return found


def load_identity(path):
    """Parsed identity.toml. A parse failure raises rather than returning {}: an empty
    result would report every field missing instead of the one line that is wrong."""
    try:
        return tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError as error:
        raise ValueError(f"{path}: {error}") from error


def sentences(text):
    return max(1, len(_SENTENCE.findall(text.strip())))


def _line(value):
    return isinstance(value, str) and value.strip() and "\n" not in value


def inside(top, path):
    """`path`, resolved through every symlink, lies strictly under `top`."""
    resolved = path.resolve()
    return resolved != top and resolved.is_relative_to(top)


def identity_problems(root, ident, nested=False, top=None):
    """Every identity-contract violation for the file at `root`, one line each. Empty means valid.

    Containment is checked here, on every file the tool will later read or write, and
    a violation blocks every command: `write` renders into these paths, so a guide that
    is a symlink to a file outside the repository would be a write outside it."""
    top = top or root.resolve()
    found = []
    for name in GUIDES + ("identity.toml",):
        path = root / name
        if name != "identity.toml" and not path.is_file():
            found.append(f"{name} is missing")
        elif not inside(top, path):
            found.append(f"{name} resolves outside the repository ({path.resolve()})")
    found.extend(f"unknown key {key}" for key in sorted(set(ident) - set(FIELDS)))
    for key in ("name", "purpose"):
        if not _line(ident.get(key)):
            found.append(f"{key} must be a non-empty single line")
    purpose = ident.get("purpose")
    if isinstance(purpose, str) and len(purpose) > PURPOSE_MAX:
        found.append(f"purpose is {len(purpose)} characters, over {PURPOSE_MAX}")
    abstract = ident.get("abstract")
    if not isinstance(abstract, str) or not abstract.strip():
        found.append("abstract must be a non-empty string")
    else:
        if len(abstract) > ABSTRACT_MAX:
            found.append(f"abstract is {len(abstract)} characters, over {ABSTRACT_MAX}")
        if sentences(abstract) > ABSTRACT_SENTENCES:
            found.append(f"abstract has {sentences(abstract)} sentences, over {ABSTRACT_SENTENCES}")
    aliases = ident.get("aliases", [])
    if not isinstance(aliases, list) or any(not _line(a) for a in aliases):
        found.append("aliases must be a list of non-empty single lines")
    for rel in _string_list(ident, "authority", found):
        if not (root / rel).exists():
            found.append(f"authority {rel} does not exist")
        elif not tracked(root, rel):
            found.append(f"authority {rel} is not tracked")
    subsystems = _string_list(ident, "subsystems", found)
    if nested and "subsystems" in ident:
        found.append("subsystems is not allowed in a subsystem")
    elif not nested:
        for rel in subsystems:
            sub = root / rel
            # Containment before any read: the directory, resolved through every
            # symlink, must be strictly inside the repository. Everything after this
            # reads and later writes under `sub`.
            if pathlib.PurePath(rel).is_absolute() or ".." in pathlib.PurePath(rel).parts:
                found.append(f"subsystem {rel} must be a relative path inside the repository")
                continue
            if not inside(top, sub):
                found.append(f"subsystem {rel} is outside the repository (resolves to {sub.resolve()})")
                continue
            if not sub.is_dir():
                found.append(f"subsystem {rel} does not exist")
                continue
            if not tracked(root, rel):
                found.append(f"subsystem {rel} is not tracked")
            child = sub / "identity.toml"
            if not inside(top, child):
                found.append(f"subsystem {rel}/identity.toml resolves outside the repository")
                continue
            if not child.is_file():
                found.append(f"subsystem {rel} has no identity.toml")
                continue
            try:
                inner = identity_problems(sub, load_identity(child), nested=True, top=top)
            except ValueError as error:
                inner = [str(error)]
            found.extend(f"{rel}/identity.toml: {p}" for p in inner)
    if "documents" in ident:
        found.extend(documents_problems(root, ident["documents"], top, nested))
    if "code" in ident:
        found.extend(code_declaration_problems(ident["code"], nested))
    agents = ident.get("agents", {})
    if not isinstance(agents, dict):
        found.append("agents must be a table")
    else:
        found.extend(f"agents: unknown key {k}" for k in sorted(set(agents) - set(AGENTS_FIELDS)))
        budget = agents.get("budget", AGENTS_BUDGET)
        if not isinstance(budget, int) or isinstance(budget, bool) or budget <= 0:
            found.append("agents.budget must be a positive integer")
        elif "budget" in agents and budget <= AGENTS_BUDGET:
            found.append(f"agents.budget must be greater than {AGENTS_BUDGET}")
        if agents.get("scope", "project") not in SCOPES:
            found.append(f"agents.scope must be one of {', '.join(SCOPES)}")
    return found


def load_family(path):
    """Parsed family file; a parse failure raises ValueError naming the file."""
    try:
        return tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError as error:
        raise ValueError(f"{path}: {error}") from error


def _https(value):
    """An https URL that can sit inside a Markdown link unescaped."""
    return _line(value) and value.startswith("https://") and not _UNSAFE_URL.search(value)


def _contract_table_problems(kind, table):
    if not isinstance(table, dict):
        return [f"{kind} must be a table"]
    found = [f"{kind}: unknown key {key}" for key in sorted(set(table) - set(CONTRACT_FIELDS[kind]))]
    sections = table.get("sections")
    if (not isinstance(sections, list) or not sections or any(not _line(s) for s in sections)
            or len(set(sections)) != len(sections)):
        found.append(f"{kind}.sections must be a non-empty list of unique single lines")
        sections = []
    if kind == "readme":
        lead = table.get("lead", ["abstract"])
        if (not isinstance(lead, list) or not lead or any(part not in LEADS for part in lead)
                or len(set(lead)) != len(lead) or lead != sorted(lead, key=LEADS.index)):
            found.append("readme.lead must be a non-empty subsequence of purpose, abstract")
        before = table.get("status_before")
        if before is not None and (not _line(before) or before not in sections):
            found.append(f"readme.status_before {before!r} is not a listed section")
    return found


def family_problems(fam):
    """Every constraint a family file breaks, one line each. Empty means valid."""
    found = [f"unknown key {key}" for key in sorted(set(fam) - set(FAMILY_FIELDS))]
    name = fam.get("name")
    if not _line(name) or not _TAG.fullmatch(name):
        found.append("name must be a single line of lowercase letters, digits and -")
    summary = fam.get("summary")
    if not isinstance(summary, str) or not summary.strip():
        found.append("summary must be a non-empty string")
    else:
        if len(summary) > SUMMARY_MAX:
            found.append(f"summary is {len(summary)} characters, over {SUMMARY_MAX}")
        if sentences(summary) > SUMMARY_SENTENCES:
            found.append(f"summary has {sentences(summary)} sentences, over {SUMMARY_SENTENCES}")
    if not _https(fam.get("overview")):
        found.append("overview must be an https:// URL")
    members = fam.get("members")
    if not isinstance(members, list) or not members:
        found.append("members must be a non-empty list of tables")
        members = []
    seen = {"name": set(), "prefix": set(), "title": set()}
    for number, member in enumerate(members, 1):
        where = f"member {number}"
        if not isinstance(member, dict):
            found.append(f"{where} must be a table")
            continue
        found.extend(f"{where}: unknown key {key}" for key in sorted(set(member) - set(MEMBER_FIELDS)))
        for key in ("name", "prefix"):
            value = member.get(key)
            if not _line(value):
                found.append(f"{where}: {key} must be a non-empty single line")
            elif value in seen[key]:
                found.append(f"{where}: {key} {value} is listed twice")
            else:
                seen[key].add(value)
        if not _https(member.get("url")):
            found.append(f"{where}: url must be an https:// URL without whitespace or parentheses")
        title = member.get("title")
        if title is not None and (not _line(title) or _UNSAFE_TITLE.search(title)):
            found.append(f"{where}: title must be a single line without [ ] * _ ` or \\")
        elif _line(member.get("name")) or title is not None:
            shown = nav_title(member)
            if shown in seen["title"]:
                found.append(f"{where}: title {shown} is listed twice")
            seen["title"].add(shown)
        label = member.get("label")
        if not _line(label) or len(label) > LABEL_MAX or '"' in label:
            found.append(f"{where}: label must be a single line of at most {LABEL_MAX} characters, "
                         f"without a double quote")
    for kind in ("readme", "agents"):
        if kind in fam:
            found.extend(_contract_table_problems(kind, fam[kind]))
    if "code" in fam:
        code = fam["code"]
        if not isinstance(code, dict):
            found.append("code must be a table")
        else:
            found.extend(f"code: unknown key {key}" for key in sorted(set(code) - set(CODE_FIELDS)))
            if "note" in code:
                note = code["note"]
                if not _line(note) or len(note) > NOTE_MAX or "`" in note:
                    found.append(f"code.note must be a single line of at most {NOTE_MAX} characters without backticks")
    return found


def parse_family(data, label):
    """A family file's bytes, parsed and validated; ValueError names `label`."""
    try:
        fam = tomllib.loads(data.decode())
    except (UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
        raise ValueError(f"{label}: {error}") from error
    problems = family_problems(fam)
    if problems:
        raise ValueError("; ".join(f"{label}: {problem}" for problem in problems))
    return fam


def read_family(root):
    """(family, rel) for the family file this repository holds, or (None, None): a
    member's published copy, or a home's own file. One repository reads one family file."""
    held = [rel for rel in (FAMILY_COPY, FAMILY_HOME) if (root / rel).is_file()]
    if len(held) == 2:
        raise ValueError(f"both {FAMILY_HOME} and {FAMILY_COPY} are present; a repository reads one family file")
    if not held:
        return None, None
    rel = held[0]
    if not inside(root.resolve(), root / rel):
        raise ValueError(f"{rel} resolves outside the repository ({(root / rel).resolve()})")
    return load_family(root / rel), rel


def git_show(root, rel, run=subprocess.run):
    """The bytes of `rel` at HEAD in `root`, or None when HEAD does not hold it."""
    done = run(["git", "-C", str(root), "show", f"HEAD:{rel}"], capture_output=True)
    return done.stdout if done.returncode == 0 else None


def resolve_roots(prefixes, run=subprocess.run):
    """{prefix: checkout root, or None when unregistered or not checked out here}, through
    `tasks resolve`, keyed by the prefix given so a retired one maps to its live checkout."""
    try:
        done = run(["tasks", "resolve", "--json", *prefixes], capture_output=True, text=True)
    except FileNotFoundError as error:
        raise LookupError("the tasks binary is not on PATH; family commands resolve members through it") from error
    if done.returncode != 0:
        raise TrackerError(f"tasks resolve failed: {done.stderr.strip()}")
    try:
        results = json.loads(done.stdout)["results"]
    except (json.JSONDecodeError, KeyError, TypeError) as error:
        raise TrackerError(f"tasks resolve returned no results: {error}") from error
    roots = {prefix: None for prefix in prefixes}
    for result in results:
        if result.get("status") == "resolved" and result.get("input") in roots:
            path = pathlib.Path(result["root"])
            if path.is_dir():
                roots[result["input"]] = path.resolve()
    return roots


def committed_family(home, run):
    """The home's family file as committed at HEAD: (bytes, parsed)."""
    data = git_show(home, FAMILY_HOME, run)
    if data is None:
        raise LookupError(f"{FAMILY_HOME} is not committed at HEAD; commit it first")
    return data, parse_family(data, f"HEAD:{FAMILY_HOME}")


def main_worktree(root, run=subprocess.run):
    """The main checkout of `root`'s repository, so a linked worktree matches its main checkout."""
    done = run(["git", "-C", str(root), "worktree", "list", "--porcelain"],
               capture_output=True, text=True)
    if done.returncode == 0:
        first = done.stdout.splitlines()[:1]
        if first and first[0].startswith("worktree "):
            return pathlib.Path(first[0].removeprefix("worktree ")).resolve()
    return root.resolve()


def family_publish(home, home_name, run=subprocess.run, out=None):
    """Write the committed family file into every reachable member and re-render its
    guides. Never commits. 1 when a member is unreachable or its write fails."""
    out = out or sys.stdout   # read at the call: a default argument would bind the import-time stream
    data, fam = committed_family(home, run)
    if (home / FAMILY_HOME).read_bytes() != data:
        raise LookupError(f"{FAMILY_HOME} differs from HEAD; commit it, then publish what landed")
    home_root = main_worktree(home, run)
    roots = resolve_roots([entry["prefix"] for entry in fam["members"]], run)
    failed, commits = False, []
    for entry in fam["members"]:
        prefix, root = entry["prefix"], roots[entry["prefix"]]
        if root is None:
            out.write(f"{prefix}: unreachable\n")
            failed = True
            continue
        if main_worktree(root, run) == home_root:
            continue
        target = root / FAMILY_COPY
        if not inside(root, target):
            out.write(f"{prefix}: {FAMILY_COPY} resolves outside the repository ({target.resolve()})\n")
            failed = True
            continue
        # Publish re-renders whole guides and the handoff commits whole files: edits
        # already in them would be committed under a generated message. Refuse first.
        paths = [FAMILY_COPY] if not (root / "identity.toml").is_file() else [FAMILY_COPY, "README.md", "AGENTS.md"]
        status = run(["git", "-C", str(root), "status", "--porcelain", "--", *paths],
                     capture_output=True, text=True)
        if status.returncode != 0:
            out.write(f"{prefix}: git status failed: {status.stderr.strip()}\n")
            failed = True
            continue
        if status.stdout.strip():
            dirty = [line[3:] for line in status.stdout.splitlines()]
            out.write(f"{prefix}: uncommitted changes to {' '.join(dirty)}; commit or stash them, then publish again\n")
            failed = True
            continue
        state = "unchanged" if target.is_file() and target.read_bytes() == data else "written"
        if state == "written":
            target.parent.mkdir(exist_ok=True)
            target.write_bytes(data)
        if not (root / "identity.toml").is_file():
            out.write(f"{prefix}: {state}, not adopted\n")
        else:
            done = run([sys.executable, str(root / "tools" / "ops-docs"), "write", "--init"],
                       cwd=str(root), capture_output=True, text=True)
            if done.returncode != 0:
                out.write(f"{prefix}: {state}; tools/ops-docs write --init failed: {done.stderr.strip()}\n")
                failed = True
                continue
            out.write(f"{prefix}: {state}\n")
        # A first publication creates tools/family.toml untracked, and a pathspec commit
        # refuses a path git does not know: stage the paths first. shlex.join quotes the
        # root and the home name, which may carry spaces or shell punctuation.
        message = f"chore(tools): family.toml from {home_name}"
        commits.append(shlex.join(["git", "-C", str(root), "add", "--", *paths]) + " && "
                       + shlex.join(["git", "-C", str(root), "commit", "-m", message, "--", *paths]))
    if commits:
        out.write("Commit in each member:\n" + "".join(f"  {line}\n" for line in commits))
    return 1 if failed else 0


def family_check(home, run=subprocess.run):
    """Each member's committed tools/family.toml against the home's committed file, byte
    for byte. A home that lists itself reads its own file and is skipped."""
    data, fam = committed_family(home, run)
    home_root = main_worktree(home, run)
    roots = resolve_roots([entry["prefix"] for entry in fam["members"]], run)
    found = []
    for entry in fam["members"]:
        prefix, root = entry["prefix"], roots[entry["prefix"]]
        if root is None:
            found.append(f"{prefix}: unreachable")
        elif main_worktree(root, run) != home_root:
            copy = git_show(root, FAMILY_COPY, run)
            if copy is None:
                found.append(f"{prefix}: missing")
            elif copy != data:
                found.append(f"{prefix}: stale")
    return found


def family_main(action, home, ident, run):
    if not (home / FAMILY_HOME).is_file():
        sys.stderr.write(f"ops-docs: {home / FAMILY_HOME} is missing; family commands run in a family home\n")
        return 2
    try:
        if action == "publish":
            return family_publish(home, ident.get("name", home.name), run)
        found = family_check(home, run)
    except (LookupError, ValueError, TrackerError) as error:
        sys.stderr.write(f"ops-docs: {error}\n")
        return 2
    for problem in found:
        sys.stderr.write(f"ops-docs: family: {problem}\n")
    return 1 if found else 0


def contract_of(fam):
    """The default contract with a valid family's declared tables substituted."""
    if fam is None:
        return DEFAULT_CONTRACT
    contract = dict(DEFAULT_CONTRACT)
    if "readme" in fam:
        table = fam["readme"]
        contract["readme"] = {"lead": table.get("lead", ["abstract"]), "sections": table["sections"],
                              "status_before": table.get("status_before")}
    if "agents" in fam:
        contract["agents"] = {"sections": fam["agents"]["sections"]}
    return contract


def code_line(guide, family=None):
    """The AGENTS.md line citing the code organization guide, with the family's note when it has one."""
    line = f"Code follows `{guide}`."
    note = ((family or {}).get("code") or {}).get("note")
    return f"{line} {note}" if note else line


def render_identity(root, ident, kind, contract=DEFAULT_CONTRACT, guide=None, family=None):
    """Render identity.toml into the generated region for one guide. A project declaring
    `[code]` cites the code organization guide in AGENTS.md, right after its Authority line."""
    if kind == "readme":
        lead = "\n\n".join(f"*{ident['purpose'].strip()}*" if part == "purpose" else ident["abstract"].strip()
                           for part in contract["readme"]["lead"])
    else:
        lead = ident["purpose"].strip()
    lines = [IDENTITY_START, lead]
    authority = ident.get("authority") or []
    if authority:
        lines += ["", "Authority: " + ", ".join(f"`{path}`" for path in authority)]
    if kind == "agents" and "code" in ident:
        line = code_line(guide or code_guide(root), family)
        lines += [line] if authority else ["", line]
    subsystems = ident.get("subsystems") or []
    if subsystems:
        lines += ["", "Subsystems:"]
        for rel in subsystems:
            child = load_identity(root / rel / "identity.toml")
            lines.append(f"- `{rel}/` — {child['purpose'].strip()}")
    lines.append(IDENTITY_END)
    return "\n".join(lines)


def _outside_fences(text):
    fenced = False
    for i, line in enumerate(text.splitlines()):
        if line.startswith("```") or line.startswith("~~~"):
            fenced = not fenced
            continue
        if not fenced:
            yield i, line


def headings(text):
    return [(i, line[3:].strip()) for i, line in _outside_fences(text) if line.startswith("## ")]


def h1_index(text):
    for i, line in _outside_fences(text):
        if line.startswith("# "):
            return i
    return None


def type_marker(line):
    """Parse a document-type marker line (spec 5.3): grammar only, version support is
    judged elsewhere. Returns {"qualifier", "types", "version"}; raises ValueError."""
    m = _MARKER.match(line.rstrip())
    if not m or m["head"][0].isspace():
        raise ValueError("marker does not parse (expected 'Type: <qualifier >?<type>(, <type>)*; "
                         "document types <N>.')")
    parts = m["head"].split(", ")
    qualifier = None
    first = parts[0]
    for name in sorted(TYPES, key=len, reverse=True):
        if first == name:
            break
        if first.endswith(" " + name):
            qualifier, first = first[:-len(name) - 1], name
            break
    types = [first, *parts[1:]]
    for name in types:
        if name not in TYPES:
            raise ValueError(f"unknown type '{name}'")
    for name in types:
        if types.count(name) > 1:
            raise ValueError(f"type '{name}' is listed twice")
    if qualifier is not None:
        if len(qualifier.split()) > QUALIFIER_WORDS:
            raise ValueError(f"qualifier '{qualifier}' is over {QUALIFIER_WORDS} words")
        if any(c.isdigit() for c in qualifier):
            raise ValueError(f"qualifier '{qualifier}' must not be a version")
    return {"qualifier": qualifier, "types": types, "version": int(m["version"])}


def all_headings(text):
    """(line index, level, title) for every H2-H6 heading outside fences."""
    found = []
    for i, line in _outside_fences(text):
        m = re.match(r"(#{2,6}) (.*)", line)
        if m:
            found.append((i, len(m[1]), m[2].strip()))
    return found


def document_problems(text):
    """Every rule 2 and rule 3 violation (spec 7) of one document, unprefixed."""
    h1 = h1_index(text)
    if h1 is None:
        return ["no H1"]
    raw = text.splitlines()
    marker_lines = [(i, line) for i, line in _outside_fences(text) if i > h1 and _MARKER_LIKE.match(line)]
    first = next((i for i in range(h1 + 1, len(raw)) if raw[i].strip()), None)
    if first is None or not _MARKER_LIKE.match(raw[first]):
        if not marker_lines:
            return ["missing marker: the first line after the H1 must be 'Type: ...; document types <N>.'"]
        return [f"marker must be the first non-blank line after the H1 (found at line {marker_lines[0][0] + 1})"]
    if len(marker_lines) > 1:
        return [f"{len(marker_lines)} markers; exactly one is allowed"]
    try:
        marker = type_marker(marker_lines[0][1])
    except ValueError as err:
        return [str(err)]
    version = marker["version"]
    if version not in STANDARDS:
        return [f"document types {version} is not supported (supported: "
                f"{', '.join(str(v) for v in sorted(STANDARDS))})"]
    rules = STANDARDS[version]
    absent = [f"type '{name}' is not in document types {version}"
              for name in marker["types"] if name not in rules["types"]]
    if absent:
        return absent
    found = []
    for name in marker["types"]:
        if name not in rules["headings"]:
            continue
        title, how = rules["headings"][name]
        if how == "h2":
            ok = any(t == title for _, t in headings(text))
            need = f"a '## {title}' heading"
        else:
            ok = any(title in t for _, _, t in all_headings(text))
            need = f"a heading containing '{title}'"
        if not ok:
            found.append(f"a {name} needs {need}")
    return found


def document_scope(root, ident):
    """The tracked paths the document rule judges: the top-level documents, then the
    declared references in declared order (an untracked one is already an identity finding)."""
    declared = ident["documents"].get("references", [])
    return top_level_documents(root) + [rel for rel in declared if tracked(root, rel)]


def documents_findings(root, ident):
    """The document-type findings of an adopting project, each prefixed with its path."""
    if "documents" not in ident:
        return []
    found = []
    top = root.resolve()
    for rel in document_scope(root, ident):
        path = root / rel
        if not inside(top, path):
            found.append(f"{rel}: resolves outside the repository ({path.resolve()})")
        elif not path.is_file():
            found.append(f"{rel}: is tracked but missing from the working tree")
        else:
            try:
                text = path.read_text(encoding="utf-8")
            except UnicodeDecodeError:
                found.append(f"{rel}: is not UTF-8")
                continue
            found.extend(f"{rel}: {problem}" for problem in document_problems(text))
    return found + record_problems(root)


def record_problems(root):
    """Findings for a document-types marker on a decision record: any tracked `.md` under
    docs/ in a record directory or with a dated basename."""
    found = []
    top = root.resolve()
    for rel in tracked_under(root, "docs"):
        if not rel.endswith(".md"):
            continue
        if not (any(rel.startswith(d + "/") for d in RECORD_DIRS)
                or _DATED.match(posixpath.basename(rel))):
            continue
        path = root / rel
        if not inside(top, path):
            found.append(f"{rel}: resolves outside the repository ({path.resolve()})")
        elif path.is_file():
            try:
                text = path.read_text(encoding="utf-8")
            except UnicodeDecodeError:
                found.append(f"{rel}: is not UTF-8")
                continue
            if any(_MARKER_LIKE.match(line) for _, line in _outside_fences(text)):
                found.append(f"{rel}: carries a document-types marker; "
                             "a decision record is not a reference document")
    return found


def nav_title(member):
    """The text a member shows in the nav: its title, else its name."""
    return member.get("title", member.get("name"))


def code_guide(root):
    """The path to the code organization guide: docs/ in ops (its source), tools/ elsewhere."""
    if (pathlib.Path(root) / "docs" / "code-organization.md").exists():
        return "docs/code-organization.md"
    return "tools/code-organization.md"


def render_family(fam, ident, kind, rel, guide=None):
    """The family region: in the README the family name linked to its overview, the
    summary, and a nav in listed order with this member bold and unlinked; in AGENTS.md
    one line naming the family file this repository reads, and the code guide when the
    family declares `[code]` and this member has not declared it in identity.toml (a
    declaring member's identity region cites it instead)."""
    if kind == "agents":
        line = (f"Member of the {fam['name']} family ({fam['overview']}); "
                f"this repository's guides follow its contract in {rel}.")
        if "code" in fam and "code" not in ident:
            line += f"\n{code_line(guide or 'tools/code-organization.md', fam)}"
        return f"{FAMILY_START}\n{line}\n{FAMILY_END}"
    summary = " ".join(fam["summary"].split())
    nav = " · ".join(f"**{nav_title(m)}**" if m["name"] == ident["name"]
                     else f'[{nav_title(m)}]({m["url"]} "{m["label"]}")' for m in fam["members"])
    return (f"{FAMILY_START}\nPart of **[{fam['name']}]({fam['overview']})**: {summary}"
            f"\n\n{nav}\n{FAMILY_END}")


def _global(kind, ident):
    return kind == "agents" and (ident.get("agents") or {}).get("scope") == "global"


def region(text, start, end, found):
    """Record malformed markers and otherwise return their region."""
    try:
        return find_region(text, start, end)
    except ValueError as error:
        found.append(str(error))
        return None


def marker_problems(kind, text, subsystem=False):
    found = []
    spans = {"identity": region(text, IDENTITY_START, IDENTITY_END, found),
             "status": region(text, STATUS_START, STATUS_END, found),
             "family": region(text, FAMILY_START, FAMILY_END, found)}
    present = [(name, span) for name, span in spans.items() if span is not None]
    for i, (first, a) in enumerate(present):
        for second, b in present[i + 1:]:
            if a[0] < b[1] and b[0] < a[1]:
                found.append(f"{first} and {second} regions overlap")
    if spans["status"] is not None and (kind == "agents" or subsystem):
        found.append("status region is allowed only in the root README")
    if spans["family"] is not None and subsystem:
        found.append("family region is allowed only in the root guides")
    return found


def status_leading(contract):
    """The contracted README sections that precede the status region, or None when the
    contract allows no status region."""
    readme = contract["readme"]
    before = readme.get("status_before")
    if before is None:
        return None
    return readme["sections"][:readme["sections"].index(before)]


def shape_problems(kind, text, ident, subsystem=False, contract=DEFAULT_CONTRACT, member=False):
    found = marker_problems(kind, text, subsystem)
    lines = text.splitlines()
    try:
        span = find_region(text, IDENTITY_START, IDENTITY_END)
    except ValueError:
        span = None
    if span is None and not any("ops:identity" in problem for problem in found):
        found.append("identity region is missing")
    if not subsystem:
        try:
            family = find_region(text, FAMILY_START, FAMILY_END)
        except ValueError:
            family = None
        if member and family is None and not any("ops:family" in problem for problem in found):
            found.append("family region is missing")
        elif not member and family is not None:
            found.append("family region present, but no family file lists this repository")
        elif member and family is not None and span is not None:
            if not text[span[1]:].lstrip("\n").startswith(FAMILY_START):
                found.append("family region must directly follow the identity region")
    if _global(kind, ident):
        return found
    h1 = h1_index(text)
    if h1 is None:
        found.append("no H1")
    elif span is not None:
        after = next((i for i in range(h1 + 1, len(lines)) if lines[i].strip()), None)
        if after is None or lines[after] != IDENTITY_START:
            found.append("identity region must directly follow the H1")
    order = contract[kind]["sections"]
    seen = headings(text)
    contracted = [(i, title) for i, title in seen if title in order]
    for (_, earlier), (_, later) in zip(contracted, contracted[1:]):
        if order.index(earlier) > order.index(later):
            found.append(f"{later} must come before {earlier}")
    if contracted:
        last_i, last_title = contracted[-1]
        for i, title in seen:
            if title not in order and i < last_i:
                found.append(f"{title} must come after {last_title}")
    if kind == "readme" and not subsystem:
        try:
            status = find_region(text, STATUS_START, STATUS_END)
        except ValueError:
            status = None
        leading = status_leading(contract)
        if status is not None and leading is None:
            found.append("status region is not allowed by this contract")
        elif status is not None:
            at = text[:status[0]].count("\n")
            before = [title for i, title in seen if i < at and title in leading]
            required_before = [title for _, title in seen if title in leading]
            if before != required_before:
                found.append(f"status region must come after {required_before[-1]}")
            later = [title for i, title in seen if i < at and title not in leading]
            if later:
                found.append(f"status region must come before {later[0]}")
    return found


def budget_problems(text, ident):
    if _global("agents", ident):
        return []
    budget = (ident.get("agents") or {}).get("budget", AGENTS_BUDGET)
    count = len(text.splitlines())
    if count > budget:
        return [f"AGENTS.md is {count} lines, over the budget of {budget}"]
    return []


def claude_problems(root):
    path = root / "CLAUDE.md"
    if not path.exists() and not path.is_symlink():
        return []
    if path.is_symlink():
        if path.resolve() == (root / "AGENTS.md").resolve():
            return []
    elif path.read_text().strip() == "@AGENTS.md":
        return []
    return ["CLAUDE.md must be `@AGENTS.md` or a symlink to AGENTS.md; two agent guides diverge"]


def find_region(text, start, end):
    """Return marker offsets, or None when both markers are absent."""
    starts, ends = text.count(start), text.count(end)
    if starts == 0 and ends == 0:
        return None
    name = start.split()[1]
    if starts != 1 or ends != 1:
        raise ValueError(f"{name} markers are malformed: {starts} start, {ends} end; exactly one pair is allowed")
    a, b = text.find(start), text.find(end)
    if b < a:
        raise ValueError(f"{name} markers are malformed: end before start")
    return a, b + len(end)


def replace_region(text, start, end, block):
    span = find_region(text, start, end)
    if span is None:
        raise LookupError(f"no {start.split()[1]} markers; run `write --init` once")
    a, b = span
    return text[:a] + block + text[b:]


def _string_list(ident, key, found):
    value = ident.get(key, [])
    if not isinstance(value, list) or any(not _line(v) for v in value):
        found.append(f"{key} must be a list of non-empty single lines")
        return []
    return value


def insert_identity(text, global_scope=False):
    """`text` with empty identity markers at their contracted place: right after the H1.
    A global guide (agents.scope=global) is exempt from the H1; without one the region
    opens the file."""
    if find_region(text, IDENTITY_START, IDENTITY_END) is not None:
        return text
    h1 = h1_index(text)
    if h1 is None and global_scope:
        return f"{IDENTITY_START}\n{IDENTITY_END}\n\n{text}"
    if h1 is None:
        raise LookupError("no H1 to place the identity region after")
    lines = text.splitlines(keepends=True)
    block = f"\n{IDENTITY_START}\n{IDENTITY_END}\n"
    head = "".join(lines[:h1 + 1])
    tail = "".join(lines[h1 + 1:])
    if not tail.startswith("\n"):
        block += "\n"
    return head + block + tail


def insert_family(text):
    """`text` with empty family markers directly after the identity region."""
    if find_region(text, FAMILY_START, FAMILY_END) is not None:
        return text
    span = find_region(text, IDENTITY_START, IDENTITY_END)
    if span is None:
        raise LookupError("no identity region to place the family region after")
    return text[:span[1]] + f"\n\n{FAMILY_START}\n{FAMILY_END}" + text[span[1]:]


def insert_status(text, contract=DEFAULT_CONTRACT):
    """`text` with empty status markers before the first section that may not precede
    the region (status_before, or any section outside the contract), else at the end."""
    if find_region(text, STATUS_START, STATUS_END) is not None:
        return text
    leading = status_leading(contract)
    if leading is None:
        raise LookupError("this README's contract allows no status region")
    lines = text.splitlines(keepends=True)
    at = next((i for i, title in headings(text) if title not in leading), None)
    block = f"{STATUS_START}\n{STATUS_END}\n"
    if at is None:
        return text.rstrip("\n") + "\n\n" + block
    return "".join(lines[:at]) + block + "\n" + "".join(lines[at:])


def guides(root, ident):
    """The root and every declared subsystem, each with its identity and label prefix."""
    yield root, ident, "", False
    for rel in ident.get("subsystems") or []:
        yield root / rel, load_identity(root / rel / "identity.toml"), f"{rel}/", True


def rendered(root, ident, name, text, run=subprocess.run, subsystem=False,
             contract=DEFAULT_CONTRACT, family=None, family_rel=None, guide=None):
    kind = "readme" if name == "README.md" else "agents"
    problems = marker_problems(kind, text, subsystem)
    if problems:
        raise ValueError("; ".join(problems))
    out = replace_region(text, IDENTITY_START, IDENTITY_END,
                         render_identity(root, ident, kind, contract, guide, family))
    if family is not None and find_region(out, FAMILY_START, FAMILY_END) is not None:
        out = replace_region(out, FAMILY_START, FAMILY_END, render_family(family, ident, kind, family_rel, guide))
    if kind == "readme" and not subsystem and find_region(out, STATUS_START, STATUS_END) is not None:
        out = replace_region(out, STATUS_START, STATUS_END, render_status(goal_rows(status_records(root, run))))
    return out


def _report(found, diffs, brief, documents=()):
    repairs = []
    if documents:
        repairs.append("edit the named documents: choose reference types under "
                       "https://github.com/khughitt/ops/blob/main/docs/document-types.md "
                       "and add or repair their Type marker and required content; "
                       "on decision records remove the document-types declaration "
                       "(a plain Type label may remain)")
    if found or diffs:
        command = shlex.join([sys.executable, str(pathlib.Path(__file__).resolve()), "write"])
        repairs.append(f"run `{command}` for generated guide regions")
    repair = "; ".join(repairs)
    found = [*found, *documents]
    if brief:
        summary = "; ".join(found[:3]) if found else "a guide region is out of date"
        if len(found) > 3:
            summary += f" (+{len(found) - 3} more)"
        sys.stderr.write(f"ops-docs: {summary} — {repair}\n")
        return 1
    for problem in found:
        sys.stderr.write(f"ops-docs: {problem}\n")
    for diff in diffs:
        sys.stderr.writelines(diff)
    sys.stderr.write(f"ops-docs: {repair}\n")
    return 1


def main(argv, env, cwd, run=subprocess.run):
    parser = argparse.ArgumentParser(prog="ops-docs", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("render").add_argument("file", choices=GUIDES)
    writer = sub.add_parser("write")
    writer.add_argument("--init", action="store_true", help="insert the identity markers after the H1 when absent")
    writer.add_argument("--init-status", action="store_true", help="insert the README status markers when absent")
    checker = sub.add_parser("check")
    checker.add_argument("--brief", action="store_true", help="one line instead of a diff, for a hook")
    family_parser = sub.add_parser("family", help="in a family home: publish the family file to members, or check their copies")
    family_parser.add_argument("action", choices=("publish", "check"))
    args = parser.parse_args(argv)
    brief = getattr(args, "brief", False)

    try:
        root = repository_root(pathlib.Path(cwd))
    except LookupError as error:
        sys.stderr.write(f"ops-docs: {error}\n")
        return 2
    path = root / "identity.toml"
    if not path.is_file():
        sys.stderr.write(f"ops-docs: {path} is missing; every adopted project declares one\n")
        return 2
    if not inside(root, path):
        sys.stderr.write(f"ops-docs: {path} resolves outside the repository ({path.resolve()})\n")
        return 2
    try:
        ident = load_identity(path)
    except ValueError as error:
        sys.stderr.write(f"ops-docs: {error}\n")
        return 2
    if not (root / "README.md").is_file():
        sys.stderr.write("ops-docs: README.md is missing\n")
        return 2
    if args.command == "family":
        return family_main(args.action, root, ident, run)

    identity_findings = [f"identity.toml: {problem}" for problem in identity_problems(root, ident)]
    if "code" in ident and not code_declaration_problems(ident["code"]):
        guide = code_guide(root)
        if not (root / guide).exists():
            identity_findings.append(f"identity.toml: code: {guide} is missing; "
                                     "run `vendored adopt code-organization.md`")
    if identity_findings:
        if args.command == "check" and all(problem.endswith("is not tracked") for problem in identity_findings):
            pass
        elif args.command == "check":
            return _report(identity_findings, [], brief)
        else:
            for problem in identity_findings:
                sys.stderr.write(f"ops-docs: {problem}\n")
            return 2

    try:
        fam, rel = read_family(root)
        family_findings = [f"{rel}: {problem}" for problem in family_problems(fam)] if fam is not None else []
    except ValueError as error:
        fam, rel, family_findings = None, None, [str(error)]
    member = None
    if fam is not None and not family_findings:
        if any(entry["name"] == ident["name"] for entry in fam["members"]):
            member = fam
        elif rel == FAMILY_COPY:
            family_findings.append(f"{FAMILY_COPY}: does not list this project ({ident['name']})")
    if member is not None and "code" in member and "code" not in ident:
        guide = code_guide(root)
        if not (root / guide).exists():
            family_findings.append(f"{guide}: missing, but family {member['name']} declares [code]; "
                                   "run `vendored adopt code-organization.md`")
    if family_findings:
        if args.command == "check":
            return _report(identity_findings + family_findings, [], brief)
        for problem in family_findings:
            sys.stderr.write(f"ops-docs: {problem}\n")
        return 2
    contract = contract_of(member)

    def scope(subsystem):
        """The contract, family and family file a guide is held to: subsystems keep the default."""
        return (DEFAULT_CONTRACT, None, None, None) if subsystem else (contract, member, rel, code_guide(root))

    if args.command == "write":
        texts = [(base, decl, prefix, subsystem, name, (base / name).read_text())
                 for base, decl, prefix, subsystem in guides(root, ident) for name in GUIDES]
        refusals = [f"{prefix}{name}: {problem}"
                    for base, decl, prefix, subsystem, name, text in texts
                    for problem in marker_problems("readme" if name == "README.md" else "agents", text, subsystem)]
        if refusals:
            for problem in refusals:
                sys.stderr.write(f"ops-docs: {problem}\n")
            return 2
        outputs = []
        try:
            for base, decl, prefix, subsystem, name, text in texts:
                kind = "readme" if name == "README.md" else "agents"
                own_contract, own_family, own_rel, own_guide = scope(subsystem)
                if args.init:
                    text = insert_identity(text, _global(kind, decl))
                    if own_family is not None:
                        text = insert_family(text)
                if args.init_status and name == "README.md" and not subsystem:
                    text = insert_status(text, own_contract)
                outputs.append((base / name, rendered(base, decl, name, text, run, subsystem,
                                                      own_contract, own_family, own_rel, own_guide)))
        except (LookupError, ValueError, TrackerError) as error:
            sys.stderr.write(f"ops-docs: {error}\n")
            return 2
        for path, text in outputs:
            path.write_text(text)
        return 0

    if args.command == "render":
        try:
            sys.stdout.write(rendered(root, ident, args.file, (root / args.file).read_text(), run,
                                      False, contract, member, rel, code_guide(root)))
        except (LookupError, ValueError, TrackerError) as error:
            sys.stderr.write(f"ops-docs: {error}\n")
            return 2
        return 0

    found, diffs = identity_findings, []
    for base, decl, prefix, subsystem in guides(root, ident):
        if subsystem and not tracked(root, prefix.rstrip("/")):
            found.append(f"subsystem {prefix.rstrip('/')} is not tracked")
        own_contract, own_family, own_rel, own_guide = scope(subsystem)
        for name in GUIDES:
            label, text = prefix + name, (base / name).read_text()
            kind = "readme" if name == "README.md" else "agents"
            shape = shape_problems(kind, text, decl, subsystem, own_contract, own_family is not None)
            found.extend(f"{label}: {problem}" for problem in shape)
            if kind == "agents":
                found.extend(f"{label}: {problem}" for problem in budget_problems(text, decl))
            if marker_problems(kind, text, subsystem) or "identity region is missing" in shape:
                continue
            try:
                current = rendered(base, decl, name, text, run, subsystem, own_contract, own_family, own_rel, own_guide)
            except LookupError as error:
                sys.stderr.write(f"ops-docs: {error}\n")
                return 2
            except TrackerError as error:
                found.append(f"{label}: {error}")
                continue
            if current != text:
                diffs.append(difflib.unified_diff(text.splitlines(keepends=True), current.splitlines(keepends=True),
                                                  fromfile=label, tofile=f"ops-docs render {label}"))
        found.extend(f"{prefix}{problem}" for problem in claude_problems(base))
    documents = documents_findings(root, ident)
    if not found and not diffs and not documents:
        return 0
    return _report(found, diffs, brief, documents)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:], dict(os.environ), os.getcwd()))
